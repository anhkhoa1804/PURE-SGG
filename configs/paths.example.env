# Copy to a machine-local file outside Git, edit, then source it.
# Omit a variable to retain the current repository-relative layout.
export RESEARCH_NO1_DATA_ROOT=/absolute/path/to/data/vg150_clean
export RESEARCH_NO1_CHECKPOINT_ROOT=/absolute/path/to/checkpoints
export RESEARCH_NO1_RUN_ROOT=/absolute/path/to/runs
export RESEARCH_NO1_CACHE_ROOT=/absolute/path/to/caches

# Compatibility for existing launchers that consume DATA_ROOT directly.
export DATA_ROOT="$RESEARCH_NO1_DATA_ROOT"
export HF_HOME="$RESEARCH_NO1_CACHE_ROOT/huggingface"
